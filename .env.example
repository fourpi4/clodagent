# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# No real secrets below — every value here is a placeholder or a safe default.
# ---------------------------------------------------------------------------

# --- Multi-provider routing --------------------------------------------------
# Which provider to use when an Agent Profile doesn't pin one explicitly, and
# the order to fall back through on timeout/429/5xx/model-unavailable. Auth
# errors (401/403) and malformed requests NEVER trigger a silent fallback.
DEFAULT_PROVIDER=groq
PROVIDER_FALLBACK_ORDER=groq,gemini,openrouter,bytez

# --- Groq — recommended for local development (fast, generous free tier) ----
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Google Gemini -------------------------------------------------------------
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- OpenRouter — 400+ models, includes rotating free (":free") models ------
# Free key: https://openrouter.ai/keys
# Not every free model supports tool calling — ProviderRouter falls back
# automatically when a model rejects a tool-calling request.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Bytez — very large catalog of open models behind one key --------------
# Key: https://bytez.com/api/key
BYTEZ_API_KEY=
BYTEZ_MODEL=openai-community/gpt2
BYTEZ_BASE_URL=https://api.bytez.com
BYTEZ_TIMEOUT=60
# Optional comma-separated fallback model IDs, tried in order if BYTEZ_MODEL
# is unavailable on your account's catalog. Empty = built-in defaults
# (see DEFAULT_FALLBACK_MODELS in app/providers/bytez.py).
BYTEZ_MODEL_CANDIDATES=

# --- Mistral (La Plateforme) -----------------------------------------------------
# Key: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# --- GitHub — used by the github_discovery module and github tools ------------
# A token raises the GitHub API rate limit from 60 to 5000 req/hour.
# Only needs public_repo (read) scope, or no scope at all for public search.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# --- Agent execution guardrails ------------------------------------------------
MAX_AGENT_STEPS=8
MAX_TOOL_CALLS=12
TOOL_TIMEOUT=30
MAX_RETRIES=2
# How long a pending tool confirmation stays valid before expiring.
CONFIRMATION_TTL_SECONDS=600

# --- Storage ---------------------------------------------------------------------
DATA_DIR=./data
MCP_SERVERS_FILE=./mcp_servers.json
WORKSPACE_DIR=./workspace

# --- Web / API ---------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# SECURITY: defaults to localhost-only. Widen only if you know what you're doing.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
LOG_LEVEL=INFO

# --- API authentication (MVP bearer token) ---------------------------------------
# If set, every /api/* endpoint requires `Authorization: Bearer <key>`.
# GET /health and GET / (the UI shell) are always exempt. Leave empty to
# disable auth (fine for pure localhost development only).
AGENT_API_KEY=

# --- MCP security ------------------------------------------------------------------
# By default, the REST API cannot register a new stdio MCP server with an
# arbitrary command — only servers from the trusted mcp_servers.json file,
# or commands explicitly listed below, are accepted; even then, a new
# stdio server needs a manual confirm before its first connection.
ALLOW_DYNAMIC_STDIO_MCP=false
MCP_ALLOWED_COMMANDS=
# Env var *names* (not values) allowed to be forwarded to a dynamically
# registered stdio MCP server. Empty = none forwarded.
MCP_ALLOWED_ENV_VARS=

# --- web_fetch SSRF hardening -----------------------------------------------------
WEB_FETCH_MAX_RESPONSE_BYTES=2000000
WEB_FETCH_ALLOWED_METHODS=GET,HEAD

# Set to true to allow auto-integration of GPL/AGPL/MPL-licensed GitHub projects.
# Default is false: such projects always require manual confirmation.
ALLOW_GPL_AUTO_INTEGRATION=false
